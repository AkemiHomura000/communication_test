uint8 mode              # 运动模式: 0=全向扫描, 1=指定角度, 2=指定范围，3=锁死
float32 yaw             # 指定yaw角度 (deg)
float32 pitch           # 指定pitch角度 (deg)
float32 yaw_lower_limit    # yaw范围下限 (deg)
float32 yaw_upper_limit    # yaw范围上限 (deg)
float32 pitch_lower_limit  # pitch范围下限 (deg)
float32 pitch_upper_limit  # pitch范围上限 (deg)
